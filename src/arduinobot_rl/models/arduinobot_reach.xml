<mujoco model="arduinobot_reach">

    <!-- ============================================================
         COMPILER AND SIMULATION SETTINGS
         ============================================================ -->

    <compiler angle="radian"
              coordinate="local"
              inertiafromgeom="false"/>

    <option timestep="0.002"
            gravity="0 0 -9.81"
            integrator="RK4"/>


    <!-- ============================================================
         DEFAULT SETTINGS
         ============================================================ -->

    <default>

        <!-- Visual geometry -->
        <geom contype="1"
              conaffinity="1"
              friction="0.8 0.1 0.1"/>

        <!-- Arm joints -->
        <joint damping="0.1"
               armature="0.01"
               limited="true"/>

        <!-- Position actuators -->
        <position kp="50"
                  forcelimited="true"
                  forcerange="-30 30"/>

    </default>


    <!-- ============================================================
         ASSETS
         ============================================================ -->

    <asset>

        <!-- Simple ground material -->
        <material name="ground_material"
                  rgba="0.3 0.3 0.3 1"/>

        <material name="robot_material"
                  rgba="0.6 0.6 0.65 1"/>

        <material name="target_material"
                  rgba="1 0 0 0.8"/>

    </asset>


    <!-- ============================================================
         WORLD
         ============================================================ -->

    <worldbody>

        <!-- Ground -->
        <geom name="ground"
              type="plane"
              size="5 5 0.1"
              material="ground_material"/>


        <!-- ========================================================
             BASE LINK
             ======================================================== -->

        <body name="base_link"
              pos="0 0 0">

            <inertial
                pos="0.047813751 0.050114205 0.011410979"
                mass="0.053288777"
                fullinertia="
                    3.37e-05
                    3.12e-05
                    5.65e-05
                    3.35e-09
                    -4.41e-10
                    9.25e-08"/>

            <!-- Temporary simplified base geometry -->
            <geom name="base_visual"
                  type="box"
                  size="0.12 0.12 0.03"
                  pos="0.05 0.05 0.03"
                  material="robot_material"/>


            <!-- ====================================================
                 JOINT 1 + BASE PLATE
                 ==================================================== -->

            <body name="base_plate"
                  pos="0 0 0.307">

                <joint name="joint_1"
                       type="hinge"
                       axis="0 0 1"
                       range="-1.570796 1.570796"/>

                <inertial
                    pos="0.037456830 0.039132251 0.068646169"
                    mass="0.054531064"
                    fullinertia="
                        2.30e-05
                        2.75e-05
                        3.20e-05
                        -2.08e-06
                        1.93e-06
                        -2.33e-06"/>

                <!-- Temporary simplified geometry -->
                <geom name="base_plate_visual"
                      type="cylinder"
                      size="0.09 0.07"
                      pos="0.04 0.04 0.07"
                      material="robot_material"/>


                <!-- ================================================
                     JOINT 2 + FORWARD DRIVE ARM
                     ================================================ -->

                <body name="forward_drive_arm"
                      pos="-0.02 0 0.35">

                    <joint name="joint_2"
                           type="hinge"
                           axis="1 0 0"
                           range="-1.570796 1.570796"/>

                    <inertial
                        pos="0.041356854 0.015301914 0.006504508"
                        mass="0.016329173"
                        fullinertia="
                            1.29e-06
                            1.17e-05
                            1.25e-05
                            -1.85e-07
                            -3.52e-07
                            5.31e-09"/>

                    <!-- Temporary link geometry -->
                    <geom name="forward_arm_visual"
                          type="box"
                          size="0.06 0.40 0.035"
                          pos="0 0.40 0"
                          material="robot_material"/>


                    <!-- ============================================
                         JOINT 3 + HORIZONTAL ARM
                         ============================================ -->

                    <body name="horizontal_arm"
                          pos="0 0 0.8">

                        <joint name="joint_3"
                               type="hinge"
                               axis="1 0 0"
                               range="-1.570796 1.570796"/>

                        <inertial
                            pos="0.059426010 0.007996574 0.004040000"
                            mass="0.010945250"
                            fullinertia="
                                2.38e-07
                                1.49e-05
                                1.50e-05
                                -1.58e-07
                                5.44e-14
                                -4.00e-14"/>

                        <!-- Temporary link geometry -->
                        <geom name="horizontal_arm_visual"
                              type="box"
                              size="0.06 0.41 0.03"
                              pos="0 0.41 0"
                              material="robot_material"/>


                        <!-- ========================================
                             FIXED CLAW SUPPORT / END EFFECTOR
                             ======================================== -->

                        <body name="claw_support"
                              pos="0 0.82 0">

                            <inertial
                                pos="0.019393395 0.011560624 0.010132371"
                                mass="0.008336755"
                                fullinertia="
                                    1.39e-06
                                    2.82e-06
                                    2.19e-06
                                    5.05e-08
                                    -4.60e-07
                                    -1.60e-07"/>

                            <!-- Temporary end-effector geometry -->
                            <geom name="claw_support_visual"
                                  type="box"
                                  size="0.06 0.08 0.04"
                                  material="robot_material"/>

                            <!-- RL end-effector tracking point -->
                            <site name="end_effector"
                                  pos="0 0.08 0"
                                  size="0.02"
                                  rgba="0 1 0 1"/>

                        </body>

                    </body>

                </body>

            </body>

        </body>


        <!-- ========================================================
             TARGET MARKER
             ======================================================== -->

        <body name="target"
              mocap="true"
              pos="0.20 1.20 0.80">

            <geom name="target_marker"
                  type="sphere"
                  size="0.04"
                  material="target_material"
                  contype="0"
                  conaffinity="0"/>

        </body>

    </worldbody>


    <!-- ============================================================
         ACTUATORS
         ============================================================ -->

    <actuator>

        <position name="joint_1_actuator"
                  joint="joint_1"
                  ctrlrange="-1.570796 1.570796"
                  kp="50"/>

        <position name="joint_2_actuator"
                  joint="joint_2"
                  ctrlrange="-1.570796 1.570796"
                  kp="50"/>

        <position name="joint_3_actuator"
                  joint="joint_3"
                  ctrlrange="-1.570796 1.570796"
                  kp="50"/>

    </actuator>


    <!-- ============================================================
         SENSORS
         ============================================================ -->

    <sensor>

        <jointpos name="joint_1_position"
                  joint="joint_1"/>

        <jointpos name="joint_2_position"
                  joint="joint_2"/>

        <jointpos name="joint_3_position"
                  joint="joint_3"/>

        <jointvel name="joint_1_velocity"
                  joint="joint_1"/>

        <jointvel name="joint_2_velocity"
                  joint="joint_2"/>

        <jointvel name="joint_3_velocity"
                  joint="joint_3"/>

        <framepos name="end_effector_position"
                  objtype="site"
                  objname="end_effector"/>

    </sensor>

</mujoco>